# Actual secrets (DEEPSEEK_API_KEY, OPENAI_API_KEY) must be
# set as real environment variables on the host:
#   - Windows: System Properties -> Environment Variables (user-level), or
#     `setx DEEPSEEK_API_KEY "sk-..."` in a terminal, then restart the app.
#   - Docker/docker-compose: pass them through from the host shell, e.g.
#     `docker compose run -e DEEPSEEK_API_KEY app`, or reference
#     `${DEEPSEEK_API_KEY}` under `environment:` in docker-compose.yml so
#     compose reads it from the shell that launches it — never hardcode the
#     value in docker-compose.yml or any file in this repo.

# Which LLM backend to use: local | deepseek | openai
# Bare `uv run streamlit run app.py` defaults to "local" if this is unset.
# docker-compose.yml defaults to "deepseek" instead if this is unset/missing,
# since a container has no GPU/llama.cpp server of its own to talk to.
LLM_PROVIDER=deepseek

# Optional overrides — only needed for non-default setups (e.g. a
# non-standard llama.cpp port, or a different DeepSeek/OpenAI model name).
# Leave commented out to use the defaults baked into rag.py.
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1  
# LOCAL_LLM_MODEL=local

# DEEPSEEK_MODEL=deepseek-v4-flash

# OPENAI_MODEL=gpt-4o-mini
# LLM_BASE_URL=
# LLM_MODEL=

# Local embedding server port (default shown)
# EMBED_BASE_URL=http://localhost:11435/v1

